
#include "Xcp_Rt.h"
{#- The number of stimulation slots a configuration reserves (DD43): one per ODT it can ever
   receive into, and zero when it cannot receive at all. A macro rather than a `set`, because this
   file needs the number in two separate `for configuration in configurations` blocks -- the array
   definitions below and the Xcp_Rt initialiser at the end -- and Jinja does not share `set`
   bindings across them.

   Under a dynamic pool there is no per-list direction to consult: SET_DAQ_LIST_MODE assigns
   DIRECTION at runtime (XCP part 2 - Protocol Layer Specification 1.1/1.6.4.1.2.4), so any list
   the master allocates out of a receiving pool may receive, and the pool's whole rectangle is the
   bound -- daq_count x odt_count slots, addressed as (daqListNumber * odt_count) + odtNumber. A
   static configuration declares each list's direction up front, so only the ODTs of its non-DAQ
   lists need a slot; a pure DAQ list has nothing to store.

   `type` is optional on daq_dynamic and defaults to DAQ, which is what keeps every configuration
   written before stimulation existed reserving nothing at all.

   The result fits the uint16 stimSlotCount of Xcp_RtType by construction, so there is no guard
   here to overflow: script/source_cfg.c.jinja2 already refuses daq_count above 255 (the uint8
   maxDaqList of Xcp_EventChannelType) and config/xcp.schema.json caps odt_count at 252, for at
   most 64260; a static configuration's total is capped at 252 by the same file's 0xFB PID
   ceiling guard. #}
{%- macro stim_slot_count(configuration) -%}
{%- set stim = namespace(count=0) -%}
{%- if configuration.protocol_layer.daq_config_type | default('STATIC') == 'DYNAMIC' -%}
{%- if (configuration.daq_dynamic.type | default('DAQ')) != 'DAQ' -%}
{%- set stim.count = configuration.daq_dynamic.daq_count * configuration.daq_dynamic.odt_count -%}
{%- endif -%}
{%- else -%}
{%- for daq in configuration.daqs | default([]) if daq.type != 'DAQ' -%}
{%- set stim.count = stim.count + daq.max_odt -%}
{%- endfor -%}
{%- endif -%}
{{ stim.count }}
{%- endmacro %}
{% for configuration in configurations %}
#define Xcp_START_SEC_VAR_FAST_POWER_ON_INIT_UNSPECIFIED
#include "Xcp_MemMap.h"

{# The 00 suffix here and on Xcp_EventQueue below used to be literal while every other array in
   this loop was suffixed with loop.index0. That was invisible for as long as every configuration
   file carried exactly one configuration: the second and further iterations redefined
   Xcp_Event00/Xcp_EventQueue00 and left Xcp_EventQueue01.. undefined, so a two-configuration
   generation did not compile at all. #}
static Xcp_EventType Xcp_Event{{'%02X' % loop.index0}}[{{'0x%02Xu' % configuration.protocol_layer.event_queue_size}}];

#define Xcp_STOP_SEC_VAR_FAST_POWER_ON_INIT_UNSPECIFIED
#include "Xcp_MemMap.h"

#define Xcp_START_SEC_VAR_FAST_POWER_ON_INIT_UNSPECIFIED
#include "Xcp_MemMap.h"

static Xcp_EventQueueType Xcp_EventQueue{{'%02X' % loop.index0}} = {
    &Xcp_Event{{'%02X' % loop.index0}}[0x00u],
    0x00000000u,
    0x00000000u
};

#define Xcp_STOP_SEC_VAR_FAST_POWER_ON_INIT_UNSPECIFIED
#include "Xcp_MemMap.h"

#define Xcp_START_SEC_VAR_FAST_POWER_ON_INIT_UNSPECIFIED
#include "Xcp_MemMap.h"

static Xcp_SegmentRtType Xcp_SegmentRt{{'%02X' % loop.index0}}[{{'0x%02Xu' % ((configuration.segments | default([]))|length + 1)}}];

#define Xcp_STOP_SEC_VAR_FAST_POWER_ON_INIT_UNSPECIFIED
#include "Xcp_MemMap.h"

#define Xcp_START_SEC_VAR_FAST_POWER_ON_INIT_UNSPECIFIED
#include "Xcp_MemMap.h"

{#- One runtime record per DAQ list the configuration can present, which under DAQ_DYNAMIC is the
   whole pool rather than the lists declared under `daqs` -- there are none. Xcp_Init and
   Xcp_TriggerEventChannel both index this array by daqCount (source/Xcp.c, source/Xcp_DaqRuntime.c),
   and daqCount is the pool size under DAQ_DYNAMIC, so anything smaller is read out of bounds
   before the master has allocated a thing. #}
{%- set daq_dynamic = configuration.protocol_layer.daq_config_type | default('STATIC') == 'DYNAMIC' %}

static Xcp_DaqListRtType Xcp_DaqListRt{{'%02X' % loop.index0}}[{{'0x%02Xu' % (configuration.daq_dynamic.daq_count if daq_dynamic else configuration.daqs|length)}}];

/* XCP_MAX_DTO reaches this module as a compile definition, so a mismatch between it and the
 * value this runtime was generated for would silently change the stride of the array below.
 * A negative array size turns that into a compile error instead.
 *
 * >=, not ==: XCP_MAX_DTO is a max() fold over every configuration in the generated file
 * (script/header_cfg.h.jinja2), one macro sizing Xcp_DtoFrameType.data[] for every configuration
 * compiled into this module, not just this one. A configuration whose own max_dto is smaller than
 * another configuration's in the same file is correctly sized by the larger, shared stride --
 * requiring equality failed a multi-configuration build the moment two configurations' max_dto
 * disagreed, even though every frame remained large enough. */
typedef char Xcp_DtoFrameStrideCheck{{'%02X' % loop.index0}}[(XCP_MAX_DTO >= {{'0x%02Xu' % configuration.protocol_layer.max_dto}}) ? 1 : -1];

static Xcp_DtoFrameType Xcp_DtoFrame{{'%02X' % loop.index0}}[{{'0x%02Xu' % (configuration.protocol_layer.daq_queue_size | default(16))}}];

static Xcp_DtoQueueType Xcp_DtoQueue{{'%02X' % loop.index0}} = {
    &Xcp_DtoFrame{{'%02X' % loop.index0}}[0x00u],
    {{'0x%02Xu' % (configuration.protocol_layer.daq_queue_size | default(16))}},
    0x00u,
    0x00u,
    0x00u
};
{%- set stim_slots = stim_slot_count(configuration) | int %}
{%- if stim_slots > 0 %}

/* One stimulation slot per ODT this configuration can receive into -- see the macro at the top of
 * this file for how the count is derived, and why a configuration that cannot receive emits no
 * array here at all. Sized by XCP_MAX_DTO through Xcp_StimSlotType, so the stride check above
 * covers this array too. */
static Xcp_StimSlotType Xcp_StimSlot{{'%02X' % loop.index0}}[{{'0x%04Xu' % stim_slots}}];
{%- endif %}

#define Xcp_STOP_SEC_VAR_FAST_POWER_ON_INIT_UNSPECIFIED
#include "Xcp_MemMap.h"
{%- endfor %}

#define Xcp_START_SEC_VAR_FAST_POWER_ON_INIT_UNSPECIFIED
#include "Xcp_MemMap.h"

Xcp_RtType Xcp_Rt[{{'0x%02Xu' % configurations|length}}] = {
{%- for configuration in configurations %}
{%- set stim_slots = stim_slot_count(configuration) | int %}
    {
        &Xcp_EventQueue{{'%02X' % loop.index0}},
        &Xcp_SegmentRt{{'%02X' % loop.index0}}[0x00u],
        &Xcp_DaqListRt{{'%02X' % loop.index0}}[0x00u],
        &Xcp_DtoQueue{{'%02X' % loop.index0}},
        {% if stim_slots > 0 %}&Xcp_StimSlot{{'%02X' % loop.index0}}[0x00u]{% else %}NULL_PTR{% endif %}, /* stimSlot */
        {{'0x%04Xu' % stim_slots}} /* stimSlotCount */
    },
{%- endfor %}
};

#define Xcp_STOP_SEC_VAR_FAST_POWER_ON_INIT_UNSPECIFIED
#include "Xcp_MemMap.h"
