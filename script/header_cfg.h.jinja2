#ifndef XCP_CFG_H
#define XCP_CFG_H

#include "Xcp_Types.h"

#include "Xcp_Checksum.h"

#ifndef XCP_USER_CMD_H
#include "Xcp_UserCmd.h"
#endif /* #ifndef XCP_USER_CMD_H */

{%- set paging = namespace(supported=false) %}
{%- for configuration in configurations %}
{%- if (configuration.segments | default([]))|length > 0 %}
{%- set paging.supported = true %}
{%- endif %}
{%- endfor %}
#ifndef XCP_PAGING_SUPPORTED

/* One macro gates the whole module, so it is on when ANY configuration declares a segment. */
#define XCP_PAGING_SUPPORTED ({% if paging.supported %}STD_ON{% else %}STD_OFF{% endif %})

#endif /* #ifndef XCP_PAGING_SUPPORTED */

{%- set max_dto = namespace(value=0) %}
{%- for configuration in configurations %}
{%- if configuration.protocol_layer.max_dto > max_dto.value %}
{%- set max_dto.value = configuration.protocol_layer.max_dto %}
{%- endif %}
{%- endfor %}
#ifndef XCP_MAX_DTO

/* One macro sizes the DTO frame buffers for the whole module, so it takes the largest MAX_DTO
 * any configuration declares. */
#define XCP_MAX_DTO ({{'0x%02Xu' % max_dto.value}})

#endif /* #ifndef XCP_MAX_DTO */

{%- set daq_timestamp_supported = namespace(value=false) %}
{%- for configuration in configurations %}
{%- if configuration.protocol_layer.timestamp is defined and configuration.protocol_layer.timestamp %}
{%- set daq_timestamp_supported.value = true %}
{%- endif %}
{%- endfor %}
#ifndef XCP_DAQ_TIMESTAMP_SUPPORTED

/* STD_ON when the configuration declares a data acquisition clock. Gates the declaration of
 * Xcp_GetDaqTimestamp, so an integration without timestamps is never asked to supply a clock. One
 * macro gates the whole module, so it is on when ANY configuration declares a timestamp block. */
#define XCP_DAQ_TIMESTAMP_SUPPORTED ({% if daq_timestamp_supported.value %}STD_ON{% else %}STD_OFF{% endif %})

#endif /* #ifndef XCP_DAQ_TIMESTAMP_SUPPORTED */

{%- set daq_timestamp_size = namespace(value=0) %}
{%- for configuration in configurations %}
{%- set ts = configuration.protocol_layer.timestamp %}
{%- if ts is defined and ts %}
{%- set wire_size = {'BYTE': 1, 'WORD': 2, 'DWORD': 4}[ts.size] %}
{%- if wire_size > daq_timestamp_size.value %}
{%- set daq_timestamp_size.value = wire_size %}
{%- endif %}
{%- endif %}
{%- endfor %}
#ifndef XCP_DAQ_TIMESTAMP_SIZE

/* Timestamp field width in bytes, as transmitted; 0 when no configuration declares a timestamp,
 * otherwise the largest configured size, so the DTO frame layout can be reasoned about at compile
 * time across every configuration compiled into the module.
 * Deliberately not Xcp_TimestampTypeType's enumerator: that enum is implicit, so FOUR_BYTE is 3,
 * while the wire size is 4 and 3 is "Not allowed" (XCP part 2 - Protocol Layer Specification
 * 1.1/1.6.4.1.2.5). */
#define XCP_DAQ_TIMESTAMP_SIZE ({{ daq_timestamp_size.value }}u)

#endif /* #ifndef XCP_DAQ_TIMESTAMP_SIZE */

#define Xcp_START_SEC_CONST_UNSPECIFIED
#include "Xcp_MemMap.h"

extern const Xcp_Type Xcp[{{'0x%02Xu' % configurations|length}}];

#define Xcp_STOP_SEC_CONST_UNSPECIFIED
#include "Xcp_MemMap.h"

#endif /* #ifndef XCP_CFG_H */
